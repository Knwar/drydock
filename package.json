{
  "name": "ai-brain",
  "version": "0.1.0",
  "description": "AI Brain: a second brain and project studio. Plans projects, designs systems (C4), and runs a team of Claude Code agents on a live board. Forked from kankanban.",
  "license": "Apache-2.0",
  "author": "Kanwar Singh <hello@knwar.com> (https://knwar.com)",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "brain": "bin/brain.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "scripts",
    ".claude",
    "CLAUDE.md",
    "!.claude/settings.local.json",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"src/overlay/**\" \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/fix-node-pty.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.10.0",
    "tsx": "^4.22.4",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "private": "true"
}
